# --- range-advisor configuration ---
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# REQUIRED. Your OpenRouter API key (https://openrouter.ai/keys).
# This is the ONLY secret this app uses. It never loads a wallet key.
OPENROUTER_API_KEY=

# REQUIRED (unless WALLET_ADDRESS is set below).
# Your Uniswap V3 position NFT id on Arbitrum. To find it: open
# app.uniswap.org, connect (or paste) your wallet, click your position;
# the id is the number in the URL .../positions/v3/arbitrum/<ID>, and it
# is also the token id of the "Uniswap V3 Positions NFT" on arbiscan.io.
POSITION_TOKEN_ID=

# OPTIONAL. If POSITION_TOKEN_ID is left blank and this is set, running
# `python -m chain` lists this wallet's active position ids and exits, so
# you can copy one into POSITION_TOKEN_ID above.
WALLET_ADDRESS=

# OpenRouter model slug. Default is a valid, verified slug. Swap in an
# Opus-class model to compare, e.g.:
#   anthropic/claude-sonnet-5
#   anthropic/claude-opus-4.8
#   anthropic/claude-opus-4.7
MODEL=anthropic/claude-sonnet-4.5

# Arbitrum RPC endpoint (public default works; a private one is more reliable).
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Binance symbol used as the price/indicator proxy for your pair.
MARKET_SYMBOL=ETHUSDT
